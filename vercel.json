{
  "version": 2,
  "crons": [
    {
      "path": "/api/lead-qualified-flush",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/weekly-summary",
      "schedule": "0 9 * * 5"
    },
    {
      "path": "/api/enrich-attribution?maxAgeDays=3&lookback=10&limit=100",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync-booking-values",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/replay-failed-events?hours=24",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/error-digest?hours=24",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/gads-daily-summary?hours=24",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/gads-dissonance?days=7&fix=1&align=1",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/audience-sync?since=2019-01-01",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/gads-retract?retryPending=1",
      "schedule": "20 */6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "marangoni.studentluxe.co.uk"
        }
      ],
      "destination": "/marangoni.html"
    },
    {
      "source": "/yugo",
      "destination": "/operator.html"
    },
    {
      "source": "/urbanest",
      "destination": "/operator.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
